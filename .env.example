# =================================================================
# Smart Attendance System - Master Environment Configuration Template
# Duplicate this file to .env and customize values for your deployment.
# ZERO SECRETS SHOULD BE COMMITTED TO VERSION CONTROL.
# =================================================================

# -----------------------------------------------------------------
# 1. AWS Cloud Backend & SAM Parameters
# -----------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
REKOGNITION_COLLECTION=smart-attendance-collection
API_SECRET_KEY=dev-kiosk-secret-key-change-in-prod
LATE_CUTOFF_TIME=09:15
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:smart-attendance-security-alerts

# -----------------------------------------------------------------
# 2. Campus Geo-Fencing (Preserved from VIT Vellore POC)
# -----------------------------------------------------------------
GEOFENCE_ENABLED=true
VIT_LATITUDE=12.9710
VIT_LONGITUDE=79.1591
ALLOWED_RADIUS_METERS=500.0

# -----------------------------------------------------------------
# 3. Edge Kiosk Hardware & Camera Tuning
# -----------------------------------------------------------------
CAMERA_SOURCE=auto
CAMERA_NAME_FILTER=Logitech
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
CAMERA_FOURCC=MJPG
CAMERA_AUTOFOCUS=1
# CAMERA_FOCUS_VALUE=25  # Uncomment for fixed-distance kiosk mount

# -----------------------------------------------------------------
# 4. Face Detection & Quality Gates (VEXDET / RF-DETR Engine)
# -----------------------------------------------------------------
VEXDET_MODEL_NAME=RFDETRSmall
VEXDET_CHECKPOINT_PATH=
VEXDET_ONNX_PATH=
VEXDET_ENHANCED=true
VEXDET_ENABLE_TILING=false
VEXDET_ENABLE_TTA=false
VEXDET_SLICE_SIZE=640
VEXDET_OVERLAP_RATIO=0.25
VEXDET_WBF_IOU_THRESHOLD=0.55
VEXDET_DEVICE=auto
FACE_PADDING_PERCENT=0.25
FACE_CONF_THRESHOLD=0.80
MIN_FACE_SIZE=120
BLUR_THRESHOLD=110.0
MIN_EXPOSURE=45.0
MAX_EXPOSURE=220.0
EAR_THRESHOLD=0.22
REQUIRED_BLINKS=1
COOLDOWN_SECONDS=15.0

# Multi-frame Burst Consensus & Preprocessing
BURST_FRAME_COUNT=4
BURST_WINDOW_SECONDS=0.6
MIN_CONSECUTIVE_VALID_FRAMES=2
CLAHE_BRIGHTNESS_THRESHOLD=75.0
CLAHE_CLIP_LIMIT=2.0
JPEG_QUALITY=95
REKOGNITION_MATCH_THRESHOLD=90.0

# -----------------------------------------------------------------
# 5. Kiosk API Gateway Client & Offline Resilience
# -----------------------------------------------------------------
API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com
API_KEY=dev-kiosk-secret-key-change-in-prod
DEVICE_ID=kiosk-logitech-01
REQUEST_TIMEOUT_SEC=6.0
DB_PATH=offline_queue.db
SYNC_INTERVAL_SEC=10.0
SHOW_PREVIEW=true

# -----------------------------------------------------------------
# 6. Admin Dashboard Frontend
# -----------------------------------------------------------------
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com
VITE_API_KEY=dev-kiosk-secret-key-change-in-prod
